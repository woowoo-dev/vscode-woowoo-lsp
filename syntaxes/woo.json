{
    "name": "WooWoo",
    "scopeName": "text.woo",
    "fileTypes": ["woo"],
    "limitLineLength": false,
    "patterns": [
        {
            "include": "#documentPartStart"
        },
        {
            "include": "#include"
        },
        {
            "include": "#objectType"
        },
        {
            "include": "#verboseEnvType"
        },
        {
            "include": "#shortEnv"
        },
        {
            "include": "#shorthandEnv"
        },
        {
            "include": "#mathBlock"
        },
        {
            "include": "#outer"
        },
        {
            "include": "#mathEnv"
        },
        {
            "include": "#comment"
        },
        {
            "include": "#quote"
        }
    ],
    "repository": {
        "documentPartStart": {
            "match": "^(\\.)([A-Z]\\w+)\\s+([^\\n]+)",
            "captures": {
                "1": {
                    "name": "keyword.operator"
                },
                "2": {
                    "name": "entity.name.type.class"
                },
                "3": {
                    "name": "variable.other.readwrite"
                }
            }
        },
        "include": {
            "match": "^(\\.)(include)\\s+([^\\n]+)$",
            "captures": {
                "1": {
                    "name": "keyword.operator"
                },
                "2": {
                    "name": "entity.name.type"
                },
                "3": {
                    "name": "variable.parameter"
                }
            }
        },
        "objectType": {
            "match": "^(\\.)([A-Z][\\p{L}]+)(:)(\\s*)$",
            "captures": {
                "1": {
                    "name": "keyword.operator"
                },
                "2": {
                    "name": "storage.type"
                },
                "3": {
                    "name": "keyword.operator"
                }
            }
        },
        "quote": {
            "match": "\"",
            "name": "string"
        },
        "verboseEnvType": {
            "match": "(\")(\\.)([\\p{L}0-9_-]+)((\\.)?(\\w+))?",
            "captures": {
                "1": {
                    "name": "string"
                },
                "2": {
                    "name": "keyword.operator"
                },
                "3": {
                    "name": "entity.name.function"
                },
                "4": {
                    "name": "entity.name.function.modifier.composite"
                },
                "5": {
                    "name": "keyword.operator.dot"
                },
                "6": {
                    "name": "entity.name.function.modifier"
                }
            }
        },
        "shorthandEnv": {
            "match": "(\")([#@])([\\p{L}0-9_-]+)",
            "captures": {
                "1": {
                    "name": "string"
                },
                "2": {
                    "name": "entity.name.function"
                },
                "3": {
                    "name": "variable.parameter"
                }
            }
        },
        "shortEnv": {
            "match": "(\\.)([a-z][\\p{L}]*)(:)([\\p{L}_\\-0-9/]+)",
            "captures": {
                "1": {
                    "name": "keyword.operator"
                },
                "2": {
                    "name": "entity.name.type"
                },
                "3": {
                    "name": "keyword.operator"
                },
                "4": {
                    "name": "variable.parameter"
                }
            }
        },
        "mathBlock": {
            "begin": "^(\\s*)([.!])(equation|align|gather)(:)(\\s*)$",
            "beginCaptures": {
                "2": {
                    "name": "keyword.operator"
                },
                "3": {
                    "name": "variable.other.global"
                },
                "4": {
                    "name": "keyword.operator"
                }
            },
            "end": "^(?!\\1[ \\t])(?!\\s*$)",
            "patterns": [
                {
                    "include": "#mathBlockLine"
                }
            ]
        },
        "mathBlockLine": {
            "begin": "^(?!\\s*(?:[\"'][^\"']*[\"']|[\\p{L}_][\\w-]*):(?:\\s|$))\\s*(?=\\S)",
            "end": "$",
            "contentName": "constant.numeric",
            "patterns": [
                {
                    "include": "#latex"
                }
            ]
        },
        "outer": {
            "match": "^(\\s*)([\\.!])([a-z]+)(:)(\\s*)$",
            "captures": {
              "2": {
                "name": "keyword.operator"
              },
              "3": {
                "name": "variable.other.global"
              },
              "4": {
                "name": "keyword.operator"
              }
            }
          },
        "mathEnv": {
            "begin": "\\$",
            "beginCaptures": {
                "0": {
                    "name": "entity.name.function"
                }
            },
            "end": "\\$|^[ \\t]*$",
            "endCaptures": {
                "0": {
                    "name": "entity.name.function"
                }
            },
            "contentName": "constant.numeric",
            "patterns": [
                {
                    "include": "#latex"
                }
            ]
        },
        "latex": {
            "patterns": [
                {
                    "include": "#latexComment"
                },
                {
                    "include": "#latexText"
                },
                {
                    "include": "#latexEnvironment"
                },
                {
                    "include": "#latexNewline"
                },
                {
                    "include": "#latexCommand"
                },
                {
                    "include": "#latexScript"
                },
                {
                    "include": "#latexNumber"
                },
                {
                    "include": "#latexOperator"
                }
            ]
        },
        "latexComment": {
            "match": "%[^\\n]*",
            "name": "comment.line"
        },
        "latexText": {
            "begin": "\\\\text\\*?\\s*\\{",
            "beginCaptures": {
                "0": {
                    "name": "support.function"
                }
            },
            "end": "\\}|$",
            "endCaptures": {
                "0": {
                    "name": "support.function"
                }
            },
            "contentName": "string"
        },
        "latexEnvironment": {
            "match": "(\\\\(?:begin|end))\\s*\\{([^{}]*)\\}",
            "captures": {
                "1": {
                    "name": "keyword.control"
                },
                "2": {
                    "name": "entity.name.type"
                }
            }
        },
        "latexNewline": {
            "match": "\\\\\\\\",
            "name": "keyword.operator"
        },
        "latexCommand": {
            "match": "\\\\(?:[a-zA-Z]+|[^a-zA-Z])",
            "name": "support.function"
        },
        "latexScript": {
            "match": "[_^]",
            "name": "keyword.operator"
        },
        "latexNumber": {
            "match": "\\d+(?:\\.\\d+)?",
            "name": "constant.numeric"
        },
        "latexOperator": {
            "match": "[=<>+\\-*/&|]",
            "name": "keyword.operator"
        },
        "comment": {
            "match": "^%.*$",
            "name": "comment.line"
        }
    }
}
